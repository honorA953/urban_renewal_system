# Copy this file to .env and adjust values before running docker compose.
#
# Two ways to run this:
#
# 1) Local MariaDB container (default):
#      DB_HOST=mariadb
#      docker compose --profile local-db up -d --build
#
# 2) An external MariaDB (e.g. a separate database created on the NAS instance):
#      DB_HOST=<NAS LAN IP, e.g. 192.168.0.20>
#      DB_NAME=<the database you created there, e.g. urban_renewal_db_dev>
#      DB_USER/DB_PASSWORD = a user scoped ONLY to that database (not root, not the
#        production app's existing credentials)
#      docker compose up -d --build         (mariadb service is skipped - no profile)

# Database
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=urban_renewal_db
DB_USER=urban_renewal_app
DB_PASSWORD=change_me_app_password
MARIADB_ROOT_PASSWORD=change_me_root_password

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=480

# App
CORS_ORIGINS=http://localhost:8080
ALERT_UNCONTACTED_DAYS=14

# Seed admin account (created on first API startup if no admin exists)
ADMIN_INITIAL_PASSWORD=Admin@2026

# Gemini API key (from Google AI Studio: https://aistudio.google.com/apikey), used
# for OCR when adding a landowner from a scanned 土地登記謄本 image. Leave blank to
# disable OCR (the button will show an error).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Alternative OCR provider - runs locally via Ollama instead of calling Gemini.
# "gemini" (default) or "ollama". Only useful on a machine with a GPU and Ollama
# (https://ollama.com) installed and running; expect noticeably worse OCR accuracy
# than Gemini on dense/noisy scanned documents. Not applicable to the NAS deployment
# (no GPU there) - keep it "gemini" there.
OCR_PROVIDER=gemini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5vl:7b
