# NAS deployment environment values. Copy to `.env.nas`, fill in real values, and do
# NOT commit `.env.nas` (already covered by .gitignore's ".env" pattern - keep the
# filename starting with ".env" so that pattern still matches, or add an explicit
# ".env.nas" line to .gitignore if you rename it).
#
# Used with: sudo docker compose -p urban_renewal_new -f docker-compose.nas.yml --env-file .env.nas up -d --build

# Database - a dedicated database + user created on the NAS's native MariaDB10
# package, NOT the old production app's credentials. See the deployment plan for the
# exact CREATE DATABASE / CREATE USER statements.
#
# Connects via Unix socket, not TCP - this NAS has unrelated Docker containers
# squatting on host port 3306, so TCP to 127.0.0.1:3306 does NOT reach the native
# MariaDB10 package. Find the real socket path with:
#   mysql -u root -p -e "SHOW VARIABLES LIKE 'socket';"
DB_SOCKET=/run/mysqld/mysqld10.sock
DB_NAME=urban_renewal_db_prod
DB_USER=urban_renewal_app
DB_PASSWORD=change_me_to_the_password_you_set_on_the_nas

# JWT - generate a real random secret for this, don't reuse the local dev one.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=480

# App
CORS_ORIGINS=https://honerAI.synology.me
ALERT_UNCONTACTED_DAYS=14

# Seed admin account (created on first API startup if no admin exists)
ADMIN_INITIAL_PASSWORD=Admin@2026

# Gemini API key (from Google AI Studio: https://aistudio.google.com/apikey), used
# for OCR when adding a landowner from a scanned 土地登記謄本 image. Leave blank to
# disable OCR (the button will show an error).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
